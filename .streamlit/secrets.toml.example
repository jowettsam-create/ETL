# Copy this file to .streamlit/secrets.toml and fill in the values.
# secrets.toml is in .gitignore - never commit it.
# Anything left blank can be typed into the app's sidebar instead.

# GoodSAM: an API client ID + secret (gsk_...) is preferred; a legacy username/password also works.
GOODSAM_USERNAME = ""
GOODSAM_PASSWORD = ""

REDCAP_API_URL = "https://nswa-redcap.ambulance.nsw.gov.au/redcap/api/"
REDCAP_API_TOKEN = ""

# Set this if the page is opened by other people over the network.
# Everyone then needs this password to see the page.
APP_PASSWORD = ""
